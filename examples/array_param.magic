// MAGIC array parameters
fn sum(xs: [i32], n: i32) -> i32 {
    var i = 0;
    var total = 0;
    while i < n {
        total = total + xs[i];
        i = i + 1;
    }
    return total;
}

fn main() {
    var a: [i32] = [1; 4];
    a[0] = 10;
    a[1] = 20;
    a[2] = 30;
    a[3] = 40;
    print(sum(a, 4));
}
