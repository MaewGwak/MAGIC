// SQL tokenizer over a byte buffer: identifiers, numbers, punctuation.
// Prints the token count and the sum of all numeric literals.
fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

fn is_alpha(c: u8) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn main() {
    var buf: [u8] = [0; 8388608];
    var fd = file_open("bench-db/sql.dat", "rb");
    var n = file_read(fd, buf, 8388608);
    file_close(fd);

    var i = 0;
    var tokens: i64 = 0;
    var sum: i64 = 0;
    while i < n {
        var c = buf[i];
        if is_alpha(c) {
            while i < n && (is_alpha(buf[i]) || is_digit(buf[i])) {
                i = i + 1;
            }
            tokens = tokens + 1;
        } else if c == 32 || c == 10 || c == 13 || c == 9 {
            i = i + 1;
        } else if is_digit(c) {
            var v: i64 = 0;
            while i < n && is_digit(buf[i]) {
                v = v * 10 + ((buf[i] as i64) - 48);
                i = i + 1;
            }
            tokens = tokens + 1;
            sum = sum + v;
        } else {
            i = i + 1;
            tokens = tokens + 1;
        }
    }
    print(tokens);
    print(sum);
}
