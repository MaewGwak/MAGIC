// mini-PostgreSQL: tokenizer + recursive-descent parser + executor.
// Supports CREATE TABLE (ignored), INSERT INTO t VALUES (k, v);,
// SELECT COUNT(*) / SUM(value) FROM t; and SELECT value FROM t WHERE id = k;
fn is_digit(c: u8) -> bool {
    return c >= 48 && c <= 57;
}

fn is_alpha(c: u8) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn upper(c: u8) -> u8 {
    if c >= 97 && c <= 122 {
        return c - 32;
    }
    return c;
}

fn eq_word(buf: [u8], ts: [i32], tl: [i32], p: i32, s: str) -> bool {
    var n = tl[p];
    if n != str_len(s) {
        return false;
    }
    var i = 0;
    while i < n {
        if upper(buf[ts[p] + i]) != upper(str_byte(s, i)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}


fn bisect_bt(node: i32, key: i64, cnt: [i32], keys: [i64], maxk: i32) -> i32 {
    var lo = 0;
    var hi = cnt[node];
    while lo < hi {
        var mid = (lo + hi) / 2;
        if keys[node * (maxk + 1) + mid] < key {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}


fn bisect_gt(node: i32, key: i64, cnt: [i32], keys: [i64], maxk: i32) -> i32 {
    var lo = 0;
    var hi = cnt[node];
    while lo < hi {
        var mid = (lo + hi) / 2;
        if keys[node * (maxk + 1) + mid] <= key {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

fn btree_search(root: i32, key: i64, cnt: [i32], leaf: [u8], keys: [i64], ch: [i32], vals: [i64], maxk: i32) -> i64 {
    var node = root;
    while leaf[node] == 0 {
        var idx = bisect_gt(node, key, cnt, keys, maxk);
        node = ch[node * (maxk + 2) + idx];
    }
    var pos = bisect_bt(node, key, cnt, keys, maxk);
    if pos < cnt[node] && keys[node * (maxk + 1) + pos] == key {
        return vals[node * (maxk + 1) + pos];
    }
    return -1;
}

fn main() {
    var buf: [u8] = [0; 8388608];
    var fd = file_open("bench-db/sqldb.dat", "rb");
    var n = file_read(fd, buf, 8388608);
    file_close(fd);

    var kind: [i32] = [0; 2000000];
    var start: [i32] = [0; 2000000];
    var len: [i32] = [0; 2000000];
    var val: [i64] = [0; 2000000];
    var nt = 0;

    var i = 0;
    while i < n {
        var c = buf[i];
        if c == 32 || c == 10 || c == 13 || c == 9 {
            i = i + 1;
        } else if is_digit(c) {
            var v: i64 = 0;
            var s0 = i;
            while i < n && is_digit(buf[i]) {
                v = v * 10 + ((buf[i] as i64) - 48);
                i = i + 1;
            }
            kind[nt] = 1;
            start[nt] = s0;
            len[nt] = i - s0;
            val[nt] = v;
            nt = nt + 1;
        } else if is_alpha(c) {
            var s0 = i;
            while i < n && (is_alpha(buf[i]) || is_digit(buf[i])) {
                i = i + 1;
            }
            kind[nt] = 0;
            start[nt] = s0;
            len[nt] = i - s0;
            nt = nt + 1;
        } else {
            kind[nt] = 2;
            start[nt] = i;
            len[nt] = 1;
            i = i + 1;
            nt = nt + 1;
        }
    }

    var bcnt: [i32] = [0; 20000];
    var bleaf: [u8] = [0; 20000];
    var bnext: [i32] = [0; 20000];
    var bkeys: [i64] = [0; 1300000];
    var bvals: [i64] = [0; 1300000];
    var bch: [i32] = [0; 1320000];
    var path_node: [i32] = [0; 32];
    var path_idx: [i32] = [0; 32];
    var bnodes = 1;
    var broot = 0;
    bleaf[0] = 1;
    bnext[0] = -1;
    var indexed = 0;
    if argc() > 1 && str_eq(arg(1), "index") {
        indexed = 1;
    }

    var rk: [i64] = [0; 200000];
    var rv: [i64] = [0; 200000];
    var rows = 0;
    var checksum: i64 = 0;
    var p = 0;
    while p < nt {
        if kind[p] == 0 && eq_word(buf, start, len, p, "INSERT") {
            // INSERT INTO t VALUES ( k , v ) ;
            var k = val[p + 5];
            var v = val[p + 7];
            rk[rows] = k;
            rv[rows] = v;
            var bk = k;
            var bv = rows as i64;
            var node = broot;
            var depth = 0;
            while bleaf[node] == 0 {
                var idx = bisect_gt(node, bk, bcnt, bkeys, 64);
                path_node[depth] = node;
                path_idx[depth] = idx;
                depth = depth + 1;
                node = bch[node * 66 + idx];
            }
            var pos = bisect_bt(node, bk, bcnt, bkeys, 64);
            var j = bcnt[node];
            while j > pos {
                bkeys[node * 65 + j] = bkeys[node * 65 + j - 1];
                bvals[node * 65 + j] = bvals[node * 65 + j - 1];
                j = j - 1;
            }
            bkeys[node * 65 + pos] = bk;
            bvals[node * 65 + pos] = bv;
            bcnt[node] = bcnt[node] + 1;

            var sep: i64 = 0;
            var new_child: i32 = -1;
            var split = false;
            if bcnt[node] > 64 {
                var nn = bnodes;
                bnodes = bnodes + 1;
                bleaf[nn] = 1;
                var mid = 32;
                var m = mid;
                var t = 0;
                while m < bcnt[node] {
                    bkeys[nn * 65 + t] = bkeys[node * 65 + m];
                    bvals[nn * 65 + t] = bvals[node * 65 + m];
                    t = t + 1;
                    m = m + 1;
                }
                bcnt[nn] = t;
                bcnt[node] = mid;
                bnext[nn] = bnext[node];
                bnext[node] = nn;
                sep = bkeys[nn * 65];
                new_child = nn;
                split = true;
            }
            while split && depth > 0 {
                depth = depth - 1;
                var pnode = path_node[depth];
                var pidx = path_idx[depth];
                var j2 = bcnt[pnode];
                while j2 > pidx {
                    bkeys[pnode * 65 + j2] = bkeys[pnode * 65 + j2 - 1];
                    j2 = j2 - 1;
                }
                bkeys[pnode * 65 + pidx] = sep;
                var c2 = bcnt[pnode] + 1;
                while c2 > pidx + 1 {
                    bch[pnode * 66 + c2] = bch[pnode * 66 + c2 - 1];
                    c2 = c2 - 1;
                }
                bch[pnode * 66 + pidx + 1] = new_child;
                bcnt[pnode] = bcnt[pnode] + 1;
                if bcnt[pnode] <= 64 {
                    split = false;
                } else {
                    var nn2 = bnodes;
                    bnodes = bnodes + 1;
                    bleaf[nn2] = 0;
                    var mm = 33;
                    var tt = 0;
                    var med = bkeys[pnode * 65 + 32];
                    while mm < bcnt[pnode] {
                        bkeys[nn2 * 65 + tt] = bkeys[pnode * 65 + mm];
                        tt = tt + 1;
                        mm = mm + 1;
                    }
                    var cc = 33;
                    var tc = 0;
                    while cc <= bcnt[pnode] {
                        bch[nn2 * 66 + tc] = bch[pnode * 66 + cc];
                        tc = tc + 1;
                        cc = cc + 1;
                    }
                    bcnt[nn2] = tt;
                    bcnt[pnode] = 32;
                    sep = med;
                    new_child = nn2;
                }
            }
            if split {
                var nr = bnodes;
                bnodes = bnodes + 1;
                bleaf[nr] = 0;
                bkeys[nr * 65] = sep;
                bch[nr * 66] = broot;
                bch[nr * 66 + 1] = new_child;
                bcnt[nr] = 1;
                broot = nr;
            }
            rows = rows + 1;
            p = p + 9;
        } else if kind[p] == 0 && eq_word(buf, start, len, p, "SELECT") {
            var q = p + 1;
            if kind[q] == 0 && eq_word(buf, start, len, q, "COUNT") {
                checksum = checksum + (rows as i64);
                p = q + 6;
            } else if kind[q] == 0 && eq_word(buf, start, len, q, "SUM") {
                var total: i64 = 0;
                var r = 0;
                while r < rows {
                    total = total + rv[r];
                    r = r + 1;
                }
                checksum = checksum + total;
                p = q + 6;
            } else {
                // SELECT value FROM t WHERE id = k ;
                var key = val[p + 7];
                var found: i64 = 0;
                if indexed == 1 {
                    var ri = btree_search(broot, key, bcnt, bleaf, bkeys, bch, bvals, 64);
                    if ri >= 0 {
                        found = rv[ri as i32];
                    }
                } else {
                    var r = 0;
                    while r < rows {
                        if rk[r] == key {
                            found = rv[r];
                        }
                        r = r + 1;
                    }
                }
                checksum = checksum + found;
                p = p + 9;
            }
        } else {
            p = p + 1;
        }
    }
    print(rows);
    print(checksum);
}
