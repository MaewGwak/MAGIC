// Page-store workload with 64 KB transfer buffers: write 50k 4 KB pages, read
// them back and checksum. Same answer as pageio_magic.magic.
fn main() {
    let PAGES = 50000;
    let PAGE = 4096;
    let BIG = 65536;
    var buf: [u8] = [0; 65536];
    var fd = file_open("bench-db/pageio.dat", "wb");
    var p = 0;
    var off = 0;
    while p < PAGES {
        buf[off] = (p % 256) as u8;
        off = off + PAGE;
        if off == BIG {
            file_write(fd, buf, BIG);
            off = 0;
        }
        p = p + 1;
    }
    if off > 0 {
        file_write(fd, buf, BIG);
    }
    file_close(fd);

    var rd = file_open("bench-db/pageio.dat", "rb");
    var total: i64 = 0;
    var running = true;
    while running {
        var n = file_read(rd, buf, BIG);
        if n < BIG {
            running = false;
        }
        var a0: i64 = 0;
        var a1: i64 = 0;
        var a2: i64 = 0;
        var a3: i64 = 0;
        var j = 0;
        while j + 4 <= n {
            a0 = a0 + (buf[j] as i64);
            a1 = a1 + (buf[j + 1] as i64);
            a2 = a2 + (buf[j + 2] as i64);
            a3 = a3 + (buf[j + 3] as i64);
            j = j + 4;
        }
        while j < n {
            a0 = a0 + (buf[j] as i64);
            j = j + 1;
        }
        total = total + a0 + a1 + a2 + a3;
    }
    file_close(rd);
    print(total);
}
