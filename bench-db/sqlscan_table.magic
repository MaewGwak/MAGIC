// Tokenizer with a 256-byte character-class table: 0 space, 1 digit, 2 word,
// 3 punctuation. Same tokens and number sum as sqlscan_magic.magic.
fn main() {
    var cls: [u8] = [3; 256];
    cls[32] = 0; cls[10] = 0; cls[13] = 0; cls[9] = 0;
    var c = 48;
    while c <= 57 {
        cls[c] = 1;
        c = c + 1;
    }
    c = 65;
    while c <= 90 {
        cls[c] = 2;
        c = c + 1;
    }
    c = 97;
    while c <= 122 {
        cls[c] = 2;
        c = c + 1;
    }
    cls[95] = 2;

    var buf: [u8] = [0; 8388608];
    var fd = file_open("bench-db/sql.dat", "rb");
    var n = file_read(fd, buf, 8388608);
    file_close(fd);

    var i = 0;
    var tokens: i64 = 0;
    var sum: i64 = 0;
    while i < n {
        var k = cls[buf[i]];
        if k == 2 {
            i = i + 1;
            while i < n && cls[buf[i]] == 2 {
                i = i + 1;
            }
            tokens = tokens + 1;
        } else if k == 1 {
            var v: i64 = 0;
            while i < n && cls[buf[i]] == 1 {
                v = v * 10 + ((buf[i] as i64) - 48);
                i = i + 1;
            }
            tokens = tokens + 1;
            sum = sum + v;
        } else if k == 0 {
            i = i + 1;
        } else {
            i = i + 1;
            tokens = tokens + 1;
        }
    }
    print(tokens);
    print(sum);
}
