// Horizon Launcher Core — a small Minecraft-style launcher proof in MAGIC.
// Commands:
//   horizon init <dir>     create an instance directory with java/memory/main/classpath files
//   horizon launch <dir>   read them, build the Java command and run it
// The launcher core is deliberately file-based so an instance can be edited by hand.

fn read_value(dir: str, name: str, buf: [u8], cap: i32) -> i32 {
    var path = str_cat(str_cat(dir, "/"), name);
    if !path_exists(path) { return -1; }
    var fd = file_open(path, "r");
    if fd < 0 { return -1; }
    var n = file_read(fd, buf, cap - 1);
    file_close(fd);
    if n < 0 { return -1; }
    return n as i32;
}

fn write_value(dir: str, name: str, value: str) -> i32 {
    var path = str_cat(str_cat(dir, "/"), name);
    var fd = file_open(path, "w");
    if fd < 0 { return -1; }
    var n = file_write_str(fd, value);
    file_close(fd);
    return n as i32;
}


fn json_ws(buf: [u8], len: i32, p0: i32) -> i32 {
    var p = p0;
    while p < len {
        var c = buf[p];
        if c == 32 || c == 9 || c == 10 || c == 13 { p = p + 1; }
        else { return p; }
    }
    return p;
}

fn json_key_pos(buf: [u8], len: i32, key: str, from: i32) -> i32 {
    var klen = str_len(key) as i32;
    var i = from;
    while i + klen + 3 < len {
        if buf[i] == 34 {
            var j = 0;
            var ok = true;
            while j < klen {
                if buf[i + 1 + j] != str_byte_n(key, j, klen) { ok = false; }
                j = j + 1;
            }
            if ok && buf[i + 1 + klen] == 34 {
                var p = json_ws(buf, len, i + klen + 2);
                if p < len && buf[p] == 58 { return json_ws(buf, len, p + 1); }
            }
        }
        i = i + 1;
    }
    return -1;
}

fn json_string(buf: [u8], len: i32, p0: i32, out: [u8], cap: i32) -> i32 {
    var p = json_ws(buf, len, p0);
    if p >= len || buf[p] != 34 { return -1; }
    p = p + 1;
    var n = 0;
    while p < len && buf[p] != 34 {
        if n + 1 >= cap { return -1; }
        if buf[p] == 92 {
            p = p + 1;
            if p >= len { return -1; }
        }
        out[n] = buf[p];
        n = n + 1;
        p = p + 1;
    }
    if p >= len { return -1; }
    out[n] = 0;
    return n;
}

fn json_get_string(buf: [u8], len: i32, key: str, out: [u8], cap: i32) -> i32 {
    var p = json_key_pos(buf, len, key, 0);
    if p < 0 { return -1; }
    return json_string(buf, len, p, out, cap);
}


fn check_libraries(dir: str, buf: [u8], len: i32, out: [u8], cap: i32) -> i32 {
    var libdir = str_cat(dir, "/libraries");
    var pos = 0;
    var total = 0;
    var missing = 0;
    var running = true;
    while running {
        var p = json_key_pos(buf, len, "path", pos);
        if p < 0 { running = false; }
        else {
            var n = json_string(buf, len, p, out, cap);
            if n >= 0 {
                total = total + 1;
                var rel = str_from_bytes(out, n);
                var full = str_cat(str_cat(libdir, "/"), rel);
                if !path_exists(full) {
                    missing = missing + 1;
                    print(str_cat("horizon: missing library ", rel));
                }
            }
            pos = p + 1;
        }
    }
    print("horizon: libraries total");
    print(total);
    print("horizon: libraries missing");
    print(missing);
    return missing;
}

fn main() {
    if argc() < 3 {
        print("horizon: usage: horizon init|list|show|set|doctor|import|assets|launch <dir>");
        return;
    }
    var cmd = arg(1);
    var dir = arg(2);
    var jbuf: [u8] = [0; 256];
    var mbuf: [u8] = [0; 256];
    var nbuf: [u8] = [0; 256];
    var cbuf: [u8] = [0; 256];
    var dbuf: [u8] = [0; 4096];
    var vbuf: [u8] = [0; 512];
    var jarbuf: [u8] = [0; 512];
    var gabuf: [u8] = [0; 1024];
    var jabuf: [u8] = [0; 1024];
    var jsonbuf: [u8] = [0; 65536];
    var outbuf: [u8] = [0; 512];

    if str_eq(cmd, "init") {
        if dir_mkdir(dir) != 0 && !path_exists(dir) {
            print("horizon: cannot create instance directory");
            return;
        }
        write_value(dir, "java", "java");
        write_value(dir, "memory", "2G");
        write_value(dir, "main", "net.minecraft.client.main.Main");
        write_value(dir, "classpath", "");
        write_value(dir, "version", "1.20.1");
        write_value(dir, "jar", "");
        write_value(dir, "jvmargs", "");
        write_value(dir, "gameargs", "");
        print(str_cat("horizon: created instance ", dir));
        return;
    }

    if str_eq(cmd, "list") {
        var n = dir_list(dir, dbuf, 4096);
        if n < 0 {
            print("horizon: cannot read instance directory");
            return;
        }
        if n == 0 { print("horizon: no instances"); return; }
        print(str_from_bytes(dbuf, n));
        return;
    }

    if str_eq(cmd, "show") {
        if !path_exists(dir) { print("horizon: instance directory does not exist"); return; }
        var jn = read_value(dir, "java", jbuf, 256);
        var mn = read_value(dir, "memory", mbuf, 256);
        var nn = read_value(dir, "main", nbuf, 256);
        var cn = read_value(dir, "classpath", cbuf, 256);
        var vn = read_value(dir, "version", vbuf, 512);
        var rn = read_value(dir, "jar", jarbuf, 512);
        var gn = read_value(dir, "gameargs", gabuf, 1024);
        var an = read_value(dir, "jvmargs", jabuf, 1024);
        var java = "java";
        var memory = "2G";
        var main = "net.minecraft.client.main.Main";
        var classpath = "";
        var version = "1.20.1";
        var jar = "";
        var gameargs = "";
        var jvmargs = "";
        if jn >= 0 { java = str_from_bytes(jbuf, jn); }
        if mn >= 0 { memory = str_from_bytes(mbuf, mn); }
        if nn >= 0 { main = str_from_bytes(nbuf, nn); }
        if cn >= 0 { classpath = str_from_bytes(cbuf, cn); }
        if vn >= 0 { version = str_from_bytes(vbuf, vn); }
        if rn >= 0 { jar = str_from_bytes(jarbuf, rn); }
        if gn >= 0 { gameargs = str_from_bytes(gabuf, gn); }
        if an >= 0 { jvmargs = str_from_bytes(jabuf, an); }
        print(str_cat("java: ", java));
        print(str_cat("memory: ", memory));
        print(str_cat("main: ", main));
        print(str_cat("classpath: ", classpath));
        print(str_cat("version: ", version));
        print(str_cat("jar: ", jar));
        print(str_cat("jvmargs: ", jvmargs));
        print(str_cat("gameargs: ", gameargs));
        return;
    }

    if str_eq(cmd, "set") {
        if argc() < 5 { print("horizon: set needs <dir> <key> <value>"); return; }
        if !path_exists(dir) { print("horizon: instance directory does not exist"); return; }
        var key = arg(3);
        var value = arg(4);
        if !(str_eq(key, "java") || str_eq(key, "memory") || str_eq(key, "main") || str_eq(key, "classpath") || str_eq(key, "version") || str_eq(key, "jar") || str_eq(key, "jvmargs") || str_eq(key, "gameargs")) {
            print("horizon: unknown key (java, memory, main, classpath, version, jar, jvmargs, gameargs)");
            return;
        }
        if write_value(dir, key, value) < 0 { print("horizon: cannot write config"); return; }
        print("horizon: config updated");
        return;
    }

    if str_eq(cmd, "assets") {
        if argc() < 4 { print("horizon: assets needs <dir> <version.json>"); return; }
        if !path_exists(dir) { print("horizon: instance directory does not exist"); return; }
        var fd = file_open(arg(3), "r");
        if fd < 0 { print("horizon: cannot open version json"); return; }
        var n = file_read(fd, jsonbuf, 65535);
        file_close(fd);
        if n < 0 { print("horizon: cannot read version json"); return; }
        var missing = check_libraries(dir, jsonbuf, n as i32, outbuf, 512);
        var ai = json_key_pos(jsonbuf, n as i32, "assetIndex", 0);
        if ai >= 0 {
            var idp = json_key_pos(jsonbuf, n as i32, "id", ai);
            if idp >= 0 {
                var idn = json_string(jsonbuf, n as i32, idp, outbuf, 512);
                if idn >= 0 {
                    print(str_cat("horizon: assetIndex=", str_from_bytes(outbuf, idn)));
                }
            }
        }
        if missing == 0 { print("horizon: assets/libraries OK"); }
        return;
    }

    if str_eq(cmd, "import") {
        if argc() < 4 { print("horizon: import needs <dir> <version.json>"); return; }
        if !path_exists(dir) { print("horizon: instance directory does not exist"); return; }
        var meta = arg(3);
        var fd = file_open(meta, "r");
        if fd < 0 { print("horizon: cannot open version json"); return; }
        var n = file_read(fd, jsonbuf, 65535);
        file_close(fd);
        if n < 0 { print("horizon: cannot read version json"); return; }
        var len = n as i32;
        var mn = json_get_string(jsonbuf, len, "mainClass", outbuf, 512);
        if mn >= 0 {
            write_value(dir, "main", str_from_bytes(outbuf, mn));
            print(str_cat("horizon: mainClass=", str_from_bytes(outbuf, mn)));
        } else { print("horizon: WARN mainClass not found"); }
        var vn = json_get_string(jsonbuf, len, "id", outbuf, 512);
        if vn >= 0 {
            write_value(dir, "version", str_from_bytes(outbuf, vn));
            print(str_cat("horizon: version=", str_from_bytes(outbuf, vn)));
        } else { print("horizon: WARN id not found"); }
        return;
    }

    if str_eq(cmd, "doctor") {
        if !path_exists(dir) { print("doctor: FAIL instance directory missing"); return; }
        var jn = read_value(dir, "java", jbuf, 256);
        var mn = read_value(dir, "memory", mbuf, 256);
        var nn = read_value(dir, "main", nbuf, 256);
        var cn = read_value(dir, "classpath", cbuf, 256);
        var vn = read_value(dir, "version", vbuf, 512);
        var rn = read_value(dir, "jar", jarbuf, 512);
        if jn < 0 { print("doctor: FAIL java config missing"); }
        if mn < 0 { print("doctor: FAIL memory config missing"); }
        if nn < 0 { print("doctor: FAIL main class missing"); }
        if cn < 0 { print("doctor: FAIL classpath config missing"); }
        if vn < 0 { print("doctor: FAIL version config missing"); }
        if rn < 0 { print("doctor: WARN jar not configured (using -cp)"); }
        print("doctor: OK instance config present");
        return;
    }

    if str_eq(cmd, "launch") {
        if !path_exists(dir) {
            print("horizon: instance directory does not exist");
            return;
        }
        var jn = read_value(dir, "java", jbuf, 256);
        var mn = read_value(dir, "memory", mbuf, 256);
        var nn = read_value(dir, "main", nbuf, 256);
        var cn = read_value(dir, "classpath", cbuf, 256);
        var vn = read_value(dir, "version", vbuf, 512);
        var rn = read_value(dir, "jar", jarbuf, 512);
        var gn = read_value(dir, "gameargs", gabuf, 1024);
        var an = read_value(dir, "jvmargs", jabuf, 1024);

        var java = "java";
        var memory = "2G";
        var main = "net.minecraft.client.main.Main";
        var classpath = "";
        var version = "1.20.1";
        var jar = "";
        var gameargs = "";
        var jvmargs = "";
        if jn >= 0 { java = str_from_bytes(jbuf, jn); }
        if mn >= 0 { memory = str_from_bytes(mbuf, mn); }
        if nn >= 0 { main = str_from_bytes(nbuf, nn); }
        if cn >= 0 { classpath = str_from_bytes(cbuf, cn); }
        if vn >= 0 { version = str_from_bytes(vbuf, vn); }
        if rn >= 0 { jar = str_from_bytes(jarbuf, rn); }
        if gn >= 0 { gameargs = str_from_bytes(gabuf, gn); }
        if an >= 0 { jvmargs = str_from_bytes(jabuf, an); }

        var line = str_cat(java, str_cat(" -Xmx", str_cat(memory, str_cat(" ", jvmargs))));
        if str_eq(jar, "") {
            line = str_cat(line, str_cat(" -cp ", str_cat(classpath, str_cat(" ", main))));
        } else {
            line = str_cat(line, str_cat(" -jar ", jar));
        }
        if !str_eq(gameargs, "") { line = str_cat(line, str_cat(" ", gameargs)); }
        print(str_cat("horizon: launching: ", line));
        var rc = proc_run(line);
        if rc != 0 {
            print("horizon: java exited non-zero");
        }
        return;
    }

    print("horizon: unknown command (use init or launch)");
}
