// Ray tracer, 1536x1536, 5 spheres -- best-effort variant.
//
// Reference per pixel: normalise (u,v,1.5), then for each sphere
// b = o.d, disc = b^2 - C, t = -b - sqrt(disc), keep the nearest t>0.
//
// Three changes, all of which keep the printed sum (3 decimals):
//   1. rows are independent -> `par for` across all cores.
//   2. the ray is never normalised.  With w = (u,v,1.5), W2 = w.w,
//      t = num/W where num = (c.w) - sqrt((c.w)^2 - C*W2).  Every sphere
//      shares the positive factor 1/W, so the nearest hit can be chosen by
//      comparing num directly, and the hit point is p = w*num/W2.  This
//      removes 3 divisions and 1 sqrt per pixel.
//   3. row/cone cull: for each sphere and scanline the reachable pixels are
//      the u-interval where (c.w)^2 - C*W2 >= 0, i.e. exactly disc >= 0.
//      A pixel outside the union of the five spans has col = 0.0, and adding
//      0.0 cannot change the running sum, so it is skipped.  Spans are
//      widened by 2 pixels, so the cull is conservative.
// The normals use |p-c| = r exactly (the point is on the sphere), which is
// the same value sqrt(n.n) produces to the last bit or so.
fn main() {
    let w = 1536;
    let h = 1536;
    let inv768 = 1.0 / 768.0;

    var cx: [f64] = [0.0; 5];
    var cy: [f64] = [0.0; 5];
    var cz: [f64] = [0.0; 5];
    var rr: [f64] = [0.0; 5];
    cx[0] = 0.0;  cy[0] = 0.0;  cz[0] = 3.0; rr[0] = 1.0;
    cx[1] = 1.5;  cy[1] = 0.3;  cz[1] = 3.2; rr[1] = 0.6;
    cx[2] = -1.2; cy[2] = -0.6; cz[2] = 2.8; rr[2] = 0.7;
    cx[3] = 2.5;  cy[3] = -0.8; cz[3] = 4.0; rr[3] = 0.5;
    cx[4] = -2.0; cy[4] = 1.2;  cz[4] = 3.5; rr[4] = 0.4;

    let lx = 5.0;
    let ly = 5.0;
    let lz = 0.0;

    // per row: five [lo,hi] pixel spans plus their union (stride 16 = one line)
    var ivl: [i32] = [0; h * 16];
    var rows: [f64] = [0.0; h];

    var y = 0;
    while y < h {
        var v = ((y as f64) - 768.0) * inv768;
        var s = 0;
        var umin = w;
        var umax = 0 - 1;
        while s < 5 {
            // disc >= 0  <=>  A*u^2 + B*u + D >= 0
            var C = cx[s] * cx[s] + cy[s] * cy[s] + cz[s] * cz[s] - rr[s] * rr[s];
            var A = rr[s] * rr[s] - cy[s] * cy[s] - cz[s] * cz[s];
            var k = cy[s] * v + 1.5 * cz[s];
            var B = 2.0 * cx[s] * k;
            var D = k * k - C * (v * v + 2.25);
            var lo = w;
            var hi = 0 - 1;
            if A < 0.0 {
                var q = B * B - 4.0 * A * D;
                if q > 0.0 {
                    var sq = sqrt(q);
                    var u1 = (0.0 - B - sq) / (2.0 * A);
                    var u2 = (0.0 - B + sq) / (2.0 * A);
                    var ulo = u1;
                    var uhi = u2;
                    if u2 < u1 {
                        ulo = u2;
                        uhi = u1;
                    }
                    var xlo = (768.0 + 768.0 * ulo) as i32;
                    var xhi = (768.0 + 768.0 * uhi) as i32;
                    xlo = xlo - 2;
                    xhi = xhi + 2;
                    if xlo < 0 {
                        xlo = 0;
                    }
                    if xhi > w - 1 {
                        xhi = w - 1;
                    }
                    if xlo <= xhi {
                        lo = xlo;
                        hi = xhi;
                    }
                }
            } else {
                lo = 0;
                hi = w - 1;
            }
            ivl[y * 16 + s] = lo;
            ivl[y * 16 + 8 + s] = hi;
            if lo < umin {
                umin = lo;
            }
            if hi > umax {
                umax = hi;
            }
            s = s + 1;
        }
        ivl[y * 16 + 5] = umin;
        ivl[y * 16 + 13] = umax;
        y = y + 1;
    }

    var ox0 = 0.0 - cx[0]; var oy0 = 0.0 - cy[0]; var oz0 = 0.0 - cz[0];
    var ox1 = 0.0 - cx[1]; var oy1 = 0.0 - cy[1]; var oz1 = 0.0 - cz[1];
    var ox2 = 0.0 - cx[2]; var oy2 = 0.0 - cy[2]; var oz2 = 0.0 - cz[2];
    var ox3 = 0.0 - cx[3]; var oy3 = 0.0 - cy[3]; var oz3 = 0.0 - cz[3];
    var ox4 = 0.0 - cx[4]; var oy4 = 0.0 - cy[4]; var oz4 = 0.0 - cz[4];
    var c0 = ox0 * ox0 + oy0 * oy0 + oz0 * oz0 - rr[0] * rr[0];
    var c1 = ox1 * ox1 + oy1 * oy1 + oz1 * oz1 - rr[1] * rr[1];
    var c2 = ox2 * ox2 + oy2 * oy2 + oz2 * oz2 - rr[2] * rr[2];
    var c3 = ox3 * ox3 + oy3 * oy3 + oz3 * oz3 - rr[3] * rr[3];
    var c4 = ox4 * ox4 + oy4 * oy4 + oz4 * oz4 - rr[4] * rr[4];

    par for y in 0..h {
        var lo0 = ivl[y * 16];      var hi0 = ivl[y * 16 + 8];
        var lo1 = ivl[y * 16 + 1];  var hi1 = ivl[y * 16 + 9];
        var lo2 = ivl[y * 16 + 2];  var hi2 = ivl[y * 16 + 10];
        var lo3 = ivl[y * 16 + 3];  var hi3 = ivl[y * 16 + 11];
        var lo4 = ivl[y * 16 + 4];  var hi4 = ivl[y * 16 + 12];
        var ulo = ivl[y * 16 + 5];
        var uhi = ivl[y * 16 + 13];

        var v = ((y as f64) - 768.0) * inv768;
        var v2 = v * v + 2.25;
        var rowsum = 0.0;
        var x = 0;
        while x < w {
            if (x >= ulo && x <= uhi) {
                var u = ((x as f64) - 768.0) * inv768;
                var w2 = u * u + v2;

                var best = 1000000000.0;
                var hit = 0 - 1;

                if (x >= lo0 && x <= hi0) {
                    var cw = cx[0] * u + cy[0] * v + 1.5 * cz[0];
                    var q = cw * cw - c0 * w2;
                    if q > 0.0 {
                        var t = cw - sqrt(q);
                        if t > 0.0 {
                            if t < best {
                                best = t;
                                hit = 0;
                            }
                        }
                    }
                }
                if (x >= lo1 && x <= hi1) {
                    var cw = cx[1] * u + cy[1] * v + 1.5 * cz[1];
                    var q = cw * cw - c1 * w2;
                    if q > 0.0 {
                        var t = cw - sqrt(q);
                        if t > 0.0 {
                            if t < best {
                                best = t;
                                hit = 1;
                            }
                        }
                    }
                }
                if (x >= lo2 && x <= hi2) {
                    var cw = cx[2] * u + cy[2] * v + 1.5 * cz[2];
                    var q = cw * cw - c2 * w2;
                    if q > 0.0 {
                        var t = cw - sqrt(q);
                        if t > 0.0 {
                            if t < best {
                                best = t;
                                hit = 2;
                            }
                        }
                    }
                }
                if (x >= lo3 && x <= hi3) {
                    var cw = cx[3] * u + cy[3] * v + 1.5 * cz[3];
                    var q = cw * cw - c3 * w2;
                    if q > 0.0 {
                        var t = cw - sqrt(q);
                        if t > 0.0 {
                            if t < best {
                                best = t;
                                hit = 3;
                            }
                        }
                    }
                }
                if (x >= lo4 && x <= hi4) {
                    var cw = cx[4] * u + cy[4] * v + 1.5 * cz[4];
                    var q = cw * cw - c4 * w2;
                    if q > 0.0 {
                        var t = cw - sqrt(q);
                        if t > 0.0 {
                            if t < best {
                                best = t;
                                hit = 4;
                            }
                        }
                    }
                }

                var col = 0.0;
                if hit >= 0 {
                    var invw2 = 1.0 / w2;
                    var f = best * invw2;
                    var px = u * f;
                    var py = v * f;
                    var pz = 1.5 * f;
                    var nx = px - cx[hit];
                    var ny = py - cy[hit];
                    var nz = pz - cz[hit];
                    var ldx = lx - px;
                    var ldy = ly - py;
                    var ldz = lz - pz;
                    var ll = sqrt(ldx * ldx + ldy * ldy + ldz * ldz);
                    var dd = (nx * ldx + ny * ldy + nz * ldz) / (rr[hit] * ll);
                    if dd < 0.0 {
                        dd = 0.0;
                    }
                    col = dd;
                }
                rowsum = rowsum + col;
            }
            x = x + 1;
        }
        rows[y] = rowsum;
    }

    var total = 0.0;
    var k = 0;
    while k < h {
        total = total + rows[k];
        k = k + 1;
    }
    print_prec(total, 3);
}
