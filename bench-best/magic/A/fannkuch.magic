// fannkuch-redux, n = 10.
//
// Parallel structure: 720 independent streams.  Three left rotations of the
// first 10, 9 and 8 entries fix the last three elements, then each stream runs
// the classic odometer over the first m = 7 positions (7! = 5040 perms).  5040
// is even, so every stream starts at an even global permutation index and the
// local alternating checksum sign equals the global one; 720*5040 = 10! covers
// every permutation exactly once in the reference order.
//
// Inner loop: the ten permutation entries live in scalar locals p0..p9 while
// the flips run.  The ten possible flip lengths are unrolled into an if-chain,
// so a flip is a fixed sequence of register swaps with no array stores and no
// per-element bounds checks.  Only the seven odometer-managed entries are
// reloaded from perm1 per permutation (the 3-element suffix is constant for the
// stream), which is all the array traffic that remains.  This is ~1.7x faster
// than flipping a memory copy in place.
//
// Each stream owns a 16-int slot (64 B) of perm1/tmp/count, so parallel
// workers touch disjoint cache lines.
fn rot(a: [i32], base: i32, len: i32, by: i32, tmp: [i32]) {
    var i = 0;
    while i < len {
        tmp[base + i] = a[base + i];
        i = i + 1;
    }
    i = 0;
    while i < len {
        var src = i + by;
        if src >= len {
            src = src - len;
        }
        a[base + i] = tmp[base + src];
        i = i + 1;
    }
}

fn main() {
    let streams = 720;
    var perm1: [i32] = [0; 11520];
    var tmp: [i32] = [0; 11520];
    var count: [i32] = [0; 11520];
    var sums: [i64] = [0; 720];
    var maxes: [i32] = [0; 720];

    par for s in 0..streams {
        var base = s * 16;
        var b1 = s / 72;
        var rem = s % 72;
        var b2 = rem / 8;
        var b3 = rem % 8;

        var i = 0;
        while i < 10 {
            perm1[base + i] = i;
            i = i + 1;
        }
        rot(perm1, base, 10, b1, tmp);
        rot(perm1, base, 9, b2, tmp);
        rot(perm1, base, 8, b3, tmp);

        var f7 = perm1[base + 7];
        var f8 = perm1[base + 8];
        var f9 = perm1[base + 9];

        var r = 7;
        var sum: i64 = 0;
        var mx = 0;
        var parity = 0;
        var running = true;

        while running {
            while r != 1 {
                count[base + r - 1] = r;
                r = r - 1;
            }

            var p0 = perm1[base];
            var p1 = perm1[base + 1];
            var p2 = perm1[base + 2];
            var p3 = perm1[base + 3];
            var p4 = perm1[base + 4];
            var p5 = perm1[base + 5];
            var p6 = perm1[base + 6];
            var p7 = f7;
            var p8 = f8;
            var p9 = f9;

            var flips = 0;
            var k = p0;
            var t = 0;
            while k != 0 {
                if k == 1 {
                    t = p0; p0 = p1; p1 = t;
                } else if k == 2 {
                    t = p0; p0 = p2; p2 = t;
                } else if k == 3 {
                    t = p0; p0 = p3; p3 = t;
                    t = p1; p1 = p2; p2 = t;
                } else if k == 4 {
                    t = p0; p0 = p4; p4 = t;
                    t = p1; p1 = p3; p3 = t;
                } else if k == 5 {
                    t = p0; p0 = p5; p5 = t;
                    t = p1; p1 = p4; p4 = t;
                    t = p2; p2 = p3; p3 = t;
                } else if k == 6 {
                    t = p0; p0 = p6; p6 = t;
                    t = p1; p1 = p5; p5 = t;
                    t = p2; p2 = p4; p4 = t;
                } else if k == 7 {
                    t = p0; p0 = p7; p7 = t;
                    t = p1; p1 = p6; p6 = t;
                    t = p2; p2 = p5; p5 = t;
                    t = p3; p3 = p4; p4 = t;
                } else if k == 8 {
                    t = p0; p0 = p8; p8 = t;
                    t = p1; p1 = p7; p7 = t;
                    t = p2; p2 = p6; p6 = t;
                    t = p3; p3 = p5; p5 = t;
                } else {
                    t = p0; p0 = p9; p9 = t;
                    t = p1; p1 = p8; p8 = t;
                    t = p2; p2 = p7; p7 = t;
                    t = p3; p3 = p6; p6 = t;
                    t = p4; p4 = p5; p5 = t;
                }
                flips = flips + 1;
                k = p0;
            }

            if flips > mx {
                mx = flips;
            }
            if parity == 0 {
                sum = sum + (flips as i64);
            } else {
                sum = sum - (flips as i64);
            }
            parity = 1 - parity;

            var advanced = false;
            while !advanced {
                if r == 7 {
                    running = false;
                    advanced = true;
                } else {
                    var q0 = perm1[base];
                    var q = 0;
                    while q < r {
                        perm1[base + q] = perm1[base + q + 1];
                        q = q + 1;
                    }
                    perm1[base + r] = q0;
                    count[base + r] = count[base + r] - 1;
                    if count[base + r] > 0 {
                        advanced = true;
                    } else {
                        r = r + 1;
                    }
                }
            }
        }
        sums[s] = sum;
        maxes[s] = mx;
    }

    var checksum: i64 = 0;
    var mxall = 0;
    var u = 0;
    while u < streams {
        checksum = checksum + sums[u];
        if maxes[u] > mxall {
            mxall = maxes[u];
        }
        u = u + 1;
    }
    print(checksum);
    print(mxall);
}
