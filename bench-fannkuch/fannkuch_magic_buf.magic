// fannkuch-redux, n = 10. The reference order is generated once into a u8
// buffer (10 bytes per permutation), then the flip counts are computed in
// parallel chunks; the global index parity gives the same checksum.
fn flips_of(base: i32, perm: [i32], n: i32) -> i32 {
    var flips = 0;
    while perm[base] != 0 {
        var k = perm[base];
        var a = 0;
        var b = k;
        while a < b {
            var t = perm[base + a];
            perm[base + a] = perm[base + b];
            perm[base + b] = t;
            a = a + 1;
            b = b - 1;
        }
        flips = flips + 1;
    }
    return flips;
}

fn main() {
    let n = 10;
    let total = 3628800;
    let parts = 16;
    let chunk = total / parts;

    var buf: [u8] = [0; total * n];
    var perm1: [i32] = [0; 10];
    var count: [i32] = [0; 10];

    var i = 0;
    while i < n {
        perm1[i] = i;
        i = i + 1;
    }

    var r = n;
    var idx = 0;
    var running = true;
    while running {
        while r != 1 {
            count[r - 1] = r;
            r = r - 1;
        }
        var j = 0;
        while j < n {
            buf[idx * n + j] = perm1[j] as u8;
            j = j + 1;
        }
        idx = idx + 1;

        var advanced = false;
        while !advanced {
            if r == n {
                running = false;
                advanced = true;
            } else {
                var p0 = perm1[0];
                var k = 0;
                while k < r {
                    perm1[k] = perm1[k + 1];
                    k = k + 1;
                }
                perm1[r] = p0;
                count[r] = count[r] - 1;
                if count[r] > 0 {
                    advanced = true;
                } else {
                    r = r + 1;
                }
            }
        }
    }

    var perm: [i32] = [0; 160];
    var sums: [i64] = [0; 16];
    var maxes: [i32] = [0; 16];

    par for t in 0..parts {
        var base = t * n;
        var lo = t * chunk;
        var hi = lo + chunk;
        var s: i64 = 0;
        var mx = 0;
        var pos = lo;
        while pos < hi {
            var j2 = 0;
            while j2 < n {
                perm[base + j2] = buf[pos * n + j2] as i32;
                j2 = j2 + 1;
            }
            var fl = flips_of(base, perm, n);
            if fl > mx {
                mx = fl;
            }
            if pos % 2 == 0 {
                s = s + (fl as i64);
            } else {
                s = s - (fl as i64);
            }
            pos = pos + 1;
        }
        sums[t] = s;
        maxes[t] = mx;
    }

    var checksum: i64 = 0;
    var mxall = 0;
    var u = 0;
    while u < parts {
        checksum = checksum + sums[u];
        if maxes[u] > mxall {
            mxall = maxes[u];
        }
        u = u + 1;
    }
    print(checksum);
    print(mxall);
}
