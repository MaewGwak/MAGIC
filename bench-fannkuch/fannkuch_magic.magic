// MAGIC fannkuch-redux, n = 10. Reference outputs: 73196 and 38.
fn main() {
    let n = 10;
    var perm1: [i32] = [0; n];
    var perm: [i32] = [0; n];
    var count: [i32] = [0; n];

    var i = 0;
    while i < n {
        perm1[i] = i;
        i = i + 1;
    }

    var r = n;
    var max_flips = 0;
    var checksum = 0;
    var perm_count = 0;
    var running = true;

    while running {
        while r != 1 {
            count[r - 1] = r;
            r = r - 1;
        }

        i = 0;
        while i < n {
            perm[i] = perm1[i];
            i = i + 1;
        }

        var flips = 0;
        while perm[0] != 0 {
            var k = perm[0];
            var a = 0;
            var b = k;
            while a < b {
                var t = perm[a];
                perm[a] = perm[b];
                perm[b] = t;
                a = a + 1;
                b = b - 1;
            }
            flips = flips + 1;
        }

        if flips > max_flips {
            max_flips = flips;
        }
        if perm_count % 2 == 0 {
            checksum = checksum + flips;
        } else {
            checksum = checksum - flips;
        }
        perm_count = perm_count + 1;

        var advanced = false;
        while !advanced {
            if r == n {
                print(checksum);
                print(max_flips);
                return;
            }
            var p0 = perm1[0];
            i = 0;
            while i < r {
                perm1[i] = perm1[i + 1];
                i = i + 1;
            }
            perm1[r] = p0;
            count[r] = count[r] - 1;
            if count[r] > 0 {
                advanced = true;
            } else {
                r = r + 1;
            }
        }
    }
}
