// n-body with the 6 body pairs written out (unrolled), for ILP/vectorization.
fn main() {
    let steps = 10000000;
    let dt = 0.001;

    var x: [f64] = [0; 4];
    var y: [f64] = [0; 4];
    var z: [f64] = [0; 4];
    var vx: [f64] = [0; 4];
    var vy: [f64] = [0; 4];
    var vz: [f64] = [0; 4];
    var m: [f64] = [0; 4];

    x[0] = 0.0;  y[0] = 0.0;  z[0] = 0.0;   vx[0] = 0.0;   vy[0] = 0.0;   vz[0] = 0.0;   m[0] = 100.0;
    x[1] = 2.0;  y[1] = 1.0;  z[1] = 0.1;   vx[1] = 0.01;  vy[1] = 0.005; vz[1] = 0.001; m[1] = 0.5;
    x[2] = 4.0;  y[2] = -1.0; z[2] = -0.1;  vx[2] = -0.01; vy[2] = -0.005; vz[2] = -0.001; m[2] = 0.3;
    x[3] = 6.0;  y[3] = 0.5;  z[3] = 0.2;   vx[3] = 0.02;  vy[3] = 0.001; vz[3] = 0.0005; m[3] = 0.2;

    for s in 0..steps {
        // (0,1)
        var dx = x[0] - x[1];
        var dy = y[0] - y[1];
        var dz = z[0] - z[1];
        var d2 = dx * dx + dy * dy + dz * dz;
        var d = sqrt(d2);
        var mag = dt / (d2 * d);
        vx[0] = vx[0] - dx * m[1] * mag;
        vy[0] = vy[0] - dy * m[1] * mag;
        vz[0] = vz[0] - dz * m[1] * mag;
        vx[1] = vx[1] + dx * m[0] * mag;
        vy[1] = vy[1] + dy * m[0] * mag;
        vz[1] = vz[1] + dz * m[0] * mag;
        // (0,2)
        var ax = x[0] - x[2];
        var ay = y[0] - y[2];
        var az = z[0] - z[2];
        var a2 = ax * ax + ay * ay + az * az;
        var ad = sqrt(a2);
        var am = dt / (a2 * ad);
        vx[0] = vx[0] - ax * m[2] * am;
        vy[0] = vy[0] - ay * m[2] * am;
        vz[0] = vz[0] - az * m[2] * am;
        vx[2] = vx[2] + ax * m[0] * am;
        vy[2] = vy[2] + ay * m[0] * am;
        vz[2] = vz[2] + az * m[0] * am;
        // (0,3)
        var bx = x[0] - x[3];
        var by = y[0] - y[3];
        var bz = z[0] - z[3];
        var b2 = bx * bx + by * by + bz * bz;
        var bd = sqrt(b2);
        var bm = dt / (b2 * bd);
        vx[0] = vx[0] - bx * m[3] * bm;
        vy[0] = vy[0] - by * m[3] * bm;
        vz[0] = vz[0] - bz * m[3] * bm;
        vx[3] = vx[3] + bx * m[0] * bm;
        vy[3] = vy[3] + by * m[0] * bm;
        vz[3] = vz[3] + bz * m[0] * bm;
        // (1,2)
        var cx = x[1] - x[2];
        var cy = y[1] - y[2];
        var cz = z[1] - z[2];
        var c2 = cx * cx + cy * cy + cz * cz;
        var cd = sqrt(c2);
        var cm = dt / (c2 * cd);
        vx[1] = vx[1] - cx * m[2] * cm;
        vy[1] = vy[1] - cy * m[2] * cm;
        vz[1] = vz[1] - cz * m[2] * cm;
        vx[2] = vx[2] + cx * m[1] * cm;
        vy[2] = vy[2] + cy * m[1] * cm;
        vz[2] = vz[2] + cz * m[1] * cm;
        // (1,3)
        var ex = x[1] - x[3];
        var ey = y[1] - y[3];
        var ez = z[1] - z[3];
        var e2 = ex * ex + ey * ey + ez * ez;
        var ed = sqrt(e2);
        var em = dt / (e2 * ed);
        vx[1] = vx[1] - ex * m[3] * em;
        vy[1] = vy[1] - ey * m[3] * em;
        vz[1] = vz[1] - ez * m[3] * em;
        vx[3] = vx[3] + ex * m[1] * em;
        vy[3] = vy[3] + ey * m[1] * em;
        vz[3] = vz[3] + ez * m[1] * em;
        // (2,3)
        var fx = x[2] - x[3];
        var fy = y[2] - y[3];
        var fz = z[2] - z[3];
        var f2 = fx * fx + fy * fy + fz * fz;
        var fd = sqrt(f2);
        var fm = dt / (f2 * fd);
        vx[2] = vx[2] - fx * m[3] * fm;
        vy[2] = vy[2] - fy * m[3] * fm;
        vz[2] = vz[2] - fz * m[3] * fm;
        vx[3] = vx[3] + fx * m[2] * fm;
        vy[3] = vy[3] + fy * m[2] * fm;
        vz[3] = vz[3] + fz * m[2] * fm;

        x[0] = x[0] + dt * vx[0];
        y[0] = y[0] + dt * vy[0];
        z[0] = z[0] + dt * vz[0];
        x[1] = x[1] + dt * vx[1];
        y[1] = y[1] + dt * vy[1];
        z[1] = z[1] + dt * vz[1];
        x[2] = x[2] + dt * vx[2];
        y[2] = y[2] + dt * vy[2];
        z[2] = z[2] + dt * vz[2];
        x[3] = x[3] + dt * vx[3];
        y[3] = y[3] + dt * vy[3];
        z[3] = z[3] + dt * vz[3];
    }

    var e = 0.0;
    for i in 0..4 {
        e = e + 0.5 * m[i] * (vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
    }
    for i in 0..4 {
        for j in i + 1..4 {
            var dx = x[i] - x[j];
            var dy = y[i] - y[j];
            var dz = z[i] - z[j];
            e = e - m[i] * m[j] / sqrt(dx * dx + dy * dy + dz * dz);
        }
    }
    print_prec(e, 9);
}
