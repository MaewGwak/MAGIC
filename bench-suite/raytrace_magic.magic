// Ray tracer, 256x256, 5 spheres. Prints total brightness.
fn main() {
    let w = 256;
    let h = 256;
    let s = 5;

    var cx: [f64] = [0; 5];
    var cy: [f64] = [0; 5];
    var cz: [f64] = [0; 5];
    var rr: [f64] = [0; 5];

    cx[0] = 0.0;  cy[0] = 0.0;  cz[0] = 3.0; rr[0] = 1.0;
    cx[1] = 1.5;  cy[1] = 0.3;  cz[1] = 3.2; rr[1] = 0.6;
    cx[2] = -1.2; cy[2] = -0.6; cz[2] = 2.8; rr[2] = 0.7;
    cx[3] = 2.5;  cy[3] = -0.8; cz[3] = 4.0; rr[3] = 0.5;
    cx[4] = -2.0; cy[4] = 1.2;  cz[4] = 3.5; rr[4] = 0.4;

    let lx = 5.0;
    let ly = 5.0;
    let lz = 0.0;

    var total = 0.0;
    var yf = 0.0;
    while yf < 1536.0 {
        var xf = 0.0;
        while xf < 1536.0 {
            var u = (xf - 768.0) / 768.0;
            var v = (yf - 768.0) / 768.0;
            var dx = u;
            var dy = v;
            var dz = 1.5;
            var len = sqrt(dx * dx + dy * dy + dz * dz);
            dx = dx / len;
            dy = dy / len;
            dz = dz / len;

            var best = 1000000000.0;
            var hit = 0 - 1;
            var i = 0;
            while i < s {
                var ox = 0.0 - cx[i];
                var oy = 0.0 - cy[i];
                var oz = 0.0 - cz[i];
                var b = ox * dx + oy * dy + oz * dz;
                var c = ox * ox + oy * oy + oz * oz - rr[i] * rr[i];
                var disc = b * b - c;
                if disc > 0.0 {
                    var t = 0.0 - b - sqrt(disc);
                    if t > 0.0 {
                        if t < best {
                            best = t;
                            hit = i;
                        }
                    }
                }
                i = i + 1;
            }

            var col = 0.0;
            if hit >= 0 {
                var px = dx * best;
                var py = dy * best;
                var pz = dz * best;
                var nx = px - cx[hit];
                var ny = py - cy[hit];
                var nz = pz - cz[hit];
                var nl = sqrt(nx * nx + ny * ny + nz * nz);
                nx = nx / nl;
                ny = ny / nl;
                nz = nz / nl;
                var ldx = lx - px;
                var ldy = ly - py;
                var ldz = lz - pz;
                var ll = sqrt(ldx * ldx + ldy * ldy + ldz * ldz);
                var d = (nx * ldx + ny * ldy + nz * ldz) / ll;
                if d < 0.0 {
                    d = 0.0;
                }
                col = d;
            }
            total = total + col;
            xf = xf + 1.0;
        }
        yf = yf + 1.0;
    }
    print_prec(total, 3);
}
