// Raytrace 1536^2, four pixels at a time with AVX2 doubles (V4).
// The scene and per-pixel arithmetic mirror the C++ best-of kernel; V4 is an
// opaque 4x f64 register handled by C-backend v4_* intrinsics.
struct V4 { a: f64, b: f64, c: f64, d: f64 }

fn main() {
    let W = 1536;
    let H = 1536;
    let HALF = 768.0;
    let S = 5;

    var CX: [f64] = [0.0; 5];
    var CY: [f64] = [0.0; 5];
    var CZ: [f64] = [0.0; 5];
    var RR: [f64] = [0.0; 5];
    CX[0] = 0.0;  CY[0] = 0.0;  CZ[0] = 3.0; RR[0] = 1.0;
    CX[1] = 1.5;  CY[1] = 0.3;  CZ[1] = 3.2; RR[1] = 0.6;
    CX[2] = -1.2; CY[2] = -0.6; CZ[2] = 2.8; RR[2] = 0.7;
    CX[3] = 2.5;  CY[3] = -0.8; CZ[3] = 4.0; RR[3] = 0.5;
    CX[4] = -2.0; CY[4] = 1.2;  CZ[4] = 3.5; RR[4] = 0.4;

    var rows: [f64] = [0.0; H];
    var vzero: V4 = v4_splat(0.0);
    var vone: V4 = v4_splat(1.0);
    var vfive: V4 = v4_splat(5.0);
    var vhuge: V4 = v4_splat(1000000000.0);
    var vnegone: V4 = v4_splat(-1.0);
    var vneghalf: V4 = v4_splat(-0.5);
    var vdz: V4 = v4_splat(1.5);
    var vscale: V4 = v4_splat(1.0 / 768.0);
    var ox0: V4 = v4_splat(-CX[0]); var oy0: V4 = v4_splat(-CY[0]); var oz0: V4 = v4_splat(-CZ[0]);
    var ox1: V4 = v4_splat(-CX[1]); var oy1: V4 = v4_splat(-CY[1]); var oz1: V4 = v4_splat(-CZ[1]);
    var ox2: V4 = v4_splat(-CX[2]); var oy2: V4 = v4_splat(-CY[2]); var oz2: V4 = v4_splat(-CZ[2]);
    var ox3: V4 = v4_splat(-CX[3]); var oy3: V4 = v4_splat(-CY[3]); var oz3: V4 = v4_splat(-CZ[3]);
    var ox4: V4 = v4_splat(-CX[4]); var oy4: V4 = v4_splat(-CY[4]); var oz4: V4 = v4_splat(-CZ[4]);
    var c00: V4 = v4_splat(CX[0]*CX[0]+CY[0]*CY[0]+CZ[0]*CZ[0]-RR[0]*RR[0]);
    var c01: V4 = v4_splat(CX[1]*CX[1]+CY[1]*CY[1]+CZ[1]*CZ[1]-RR[1]*RR[1]);
    var c02: V4 = v4_splat(CX[2]*CX[2]+CY[2]*CY[2]+CZ[2]*CZ[2]-RR[2]*RR[2]);
    var c03: V4 = v4_splat(CX[3]*CX[3]+CY[3]*CY[3]+CZ[3]*CZ[3]-RR[3]*RR[3]);
    var c04: V4 = v4_splat(CX[4]*CX[4]+CY[4]*CY[4]+CZ[4]*CZ[4]-RR[4]*RR[4]);
    var cx0: V4 = v4_splat(CX[0]); var cy0: V4 = v4_splat(CY[0]); var cz0: V4 = v4_splat(CZ[0]); var iv0: V4 = v4_splat(1.0/RR[0]);
    var cx1: V4 = v4_splat(CX[1]); var cy1: V4 = v4_splat(CY[1]); var cz1: V4 = v4_splat(CZ[1]); var iv1: V4 = v4_splat(1.0/RR[1]);
    var cx2: V4 = v4_splat(CX[2]); var cy2: V4 = v4_splat(CY[2]); var cz2: V4 = v4_splat(CZ[2]); var iv2: V4 = v4_splat(1.0/RR[2]);
    var cx3: V4 = v4_splat(CX[3]); var cy3: V4 = v4_splat(CY[3]); var cz3: V4 = v4_splat(CZ[3]); var iv3: V4 = v4_splat(1.0/RR[3]);
    var cx4: V4 = v4_splat(CX[4]); var cy4: V4 = v4_splat(CY[4]); var cz4: V4 = v4_splat(CZ[4]); var iv4: V4 = v4_splat(1.0/RR[4]);
    var sp0: V4 = v4_splat(0.0); var sp1: V4 = v4_splat(1.0); var sp2: V4 = v4_splat(2.0); var sp3: V4 = v4_splat(3.0); var sp4: V4 = v4_splat(4.0);
    par for y in 0..H {
        let v = ((y as f64) - HALF) / HALF;
        var dy0 = v4_splat(v);
        var dz0 = vdz;
        var rowacc = vzero;
        var x = 0;
        while x < W {
            var xv = v4_set(x as f64, (x + 1) as f64, (x + 2) as f64, (x + 3) as f64);
            var dx = v4_fma(xv, vscale, vnegone);
            var dy = dy0;
            var dz = dz0;
            var len2 = v4_fma(dx, dx, v4_fma(dy, dy, v4_mul(dz, dz)));
            var inv = v4_div(vone, v4_sqrt(len2));
            dx = v4_mul(dx, inv);
            dy = v4_mul(dy, inv);
            dz = v4_mul(dz, inv);
            var best = vhuge;
            var hit = vnegone;
            var b0 = v4_fma(ox0, dx, v4_fma(oy0, dy, v4_mul(oz0, dz)));
            var disc0 = v4_fma(b0, b0, v4_sub(vzero, c00));
            var dm0 = v4_cmpgt(disc0, vzero);
            if v4_any(dm0) {
                var t0 = v4_sub(v4_sub(vzero, v4_sqrt(disc0)), b0);
                var m0 = v4_and(dm0, v4_cmpgt(t0, vzero));
                m0 = v4_and(m0, v4_cmplt(t0, best));
                best = v4_blend(m0, best, t0);
                hit = v4_blend(m0, hit, sp0);
            }
            var b1 = v4_fma(ox1, dx, v4_fma(oy1, dy, v4_mul(oz1, dz)));
            var disc1 = v4_fma(b1, b1, v4_sub(vzero, c01));
            var dm1 = v4_cmpgt(disc1, vzero);
            if v4_any(dm1) {
                var t1 = v4_sub(v4_sub(vzero, v4_sqrt(disc1)), b1);
                var m1 = v4_and(dm1, v4_cmpgt(t1, vzero));
                m1 = v4_and(m1, v4_cmplt(t1, best));
                best = v4_blend(m1, best, t1);
                hit = v4_blend(m1, hit, sp1);
            }
            var b2 = v4_fma(ox2, dx, v4_fma(oy2, dy, v4_mul(oz2, dz)));
            var disc2 = v4_fma(b2, b2, v4_sub(vzero, c02));
            var dm2 = v4_cmpgt(disc2, vzero);
            if v4_any(dm2) {
                var t2 = v4_sub(v4_sub(vzero, v4_sqrt(disc2)), b2);
                var m2 = v4_and(dm2, v4_cmpgt(t2, vzero));
                m2 = v4_and(m2, v4_cmplt(t2, best));
                best = v4_blend(m2, best, t2);
                hit = v4_blend(m2, hit, sp2);
            }
            var b3 = v4_fma(ox3, dx, v4_fma(oy3, dy, v4_mul(oz3, dz)));
            var disc3 = v4_fma(b3, b3, v4_sub(vzero, c03));
            var dm3 = v4_cmpgt(disc3, vzero);
            if v4_any(dm3) {
                var t3 = v4_sub(v4_sub(vzero, v4_sqrt(disc3)), b3);
                var m3 = v4_and(dm3, v4_cmpgt(t3, vzero));
                m3 = v4_and(m3, v4_cmplt(t3, best));
                best = v4_blend(m3, best, t3);
                hit = v4_blend(m3, hit, sp3);
            }
            var b4 = v4_fma(ox4, dx, v4_fma(oy4, dy, v4_mul(oz4, dz)));
            var disc4 = v4_fma(b4, b4, v4_sub(vzero, c04));
            var dm4 = v4_cmpgt(disc4, vzero);
            if v4_any(dm4) {
                var t4 = v4_sub(v4_sub(vzero, v4_sqrt(disc4)), b4);
                var m4 = v4_and(dm4, v4_cmpgt(t4, vzero));
                m4 = v4_and(m4, v4_cmplt(t4, best));
                best = v4_blend(m4, best, t4);
                hit = v4_blend(m4, hit, sp4);
            }
            var cx = cx0; var cy = cy0; var cz = cz0; var iv = iv0;
            var ms = v4_cmpeq(hit, sp1); cx = v4_blend(ms, cx, cx1); cy = v4_blend(ms, cy, cy1); cz = v4_blend(ms, cz, cz1); iv = v4_blend(ms, iv, iv1);
            ms = v4_cmpeq(hit, sp2); cx = v4_blend(ms, cx, cx2); cy = v4_blend(ms, cy, cy2); cz = v4_blend(ms, cz, cz2); iv = v4_blend(ms, iv, iv2);
            ms = v4_cmpeq(hit, sp3); cx = v4_blend(ms, cx, cx3); cy = v4_blend(ms, cy, cy3); cz = v4_blend(ms, cz, cz3); iv = v4_blend(ms, iv, iv3);
            ms = v4_cmpeq(hit, sp4); cx = v4_blend(ms, cx, cx4); cy = v4_blend(ms, cy, cy4); cz = v4_blend(ms, cz, cz4); iv = v4_blend(ms, iv, iv4);
            var px = v4_mul(dx, best);
            var py = v4_mul(dy, best);
            var pz = v4_mul(dz, best);
            var nx = v4_mul(v4_sub(px, cx), iv);
            var ny = v4_mul(v4_sub(py, cy), iv);
            var nz = v4_mul(v4_sub(pz, cz), iv);
            var lx = v4_sub(vfive, px);
            var ly = v4_sub(vfive, py);
            var lz = v4_sub(vzero, pz);
            var dot = v4_fma(nx, lx, v4_fma(ny, ly, v4_mul(nz, lz)));
            var ll2 = v4_fma(lx, lx, v4_fma(ly, ly, v4_mul(lz, lz)));
            var col = v4_div(dot, v4_sqrt(ll2));
            col = v4_max(col, vzero);
            var hitm = v4_cmpgt(hit, vneghalf);
            rowacc = v4_add(rowacc, v4_and(col, hitm));
            x = x + 4;
        }
        rows[y] = (v4_extract(rowacc, 0) + v4_extract(rowacc, 1)) + (v4_extract(rowacc, 2) + v4_extract(rowacc, 3));
    }

    var total = 0.0;
    var y = 0;
    while y < H {
        total = total + rows[y];
        y = y + 1;
    }
    print_prec(total, 3);
}
